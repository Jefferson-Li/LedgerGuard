# Copy to .env for local `uv run`. Do not commit .env. No secret values belong here.
# Gemini on Vertex AI. ADK 2.12 reads GOOGLE_GENAI_USE_ENTERPRISE (the older
# GOOGLE_GENAI_USE_VERTEXAI name still works, and ADK warns that it is deprecated).
GOOGLE_CLOUD_PROJECT=your-project-id
GOOGLE_CLOUD_LOCATION=global
GOOGLE_GENAI_USE_ENTERPRISE=TRUE
LEDGERGUARD_MODEL=gemini-2.5-flash

# Exception triage. stub needs no credentials. gemini calls Vertex AI.
LEDGERGUARD_TRIAGE_JUDGE=stub
LEDGERGUARD_TRIAGE_CONFIDENCE_THRESHOLD=0.8
LEDGERGUARD_TRIAGE_FLASH_MODEL=gemini-2.5-flash
LEDGERGUARD_TRIAGE_PRO_MODEL=gemini-2.5-pro
# Empty keeps Firestore as a dry run preview inside apply/reset.
LEDGERGUARD_FIRESTORE_DECISIONS=

# Full resource names. Leave blank to keep screening fail-closed.
# Prompt template: PI/jailbreak HIGH, RAI MEDIUM_AND_ABOVE, malicious URI, SDP off.
# Response template: the same filters plus SDP de-identify, so checkpoint 3 can mask.
MODEL_ARMOR_PROMPT_TEMPLATE=
MODEL_ARMOR_RESPONSE_TEMPLATE=
# Optional single-template fallback used when the two names above are empty.
MODEL_ARMOR_TEMPLATE=

# Local only. Never set this on Cloud Run. true lets invoice text through with no Model Armor call.
MODEL_ARMOR_ALLOW_UNSCREENED=false

# Local process URLs. Compose uses the Docker network names instead.
ERP_MCP_URL=http://localhost:8090/mcp
INVOICE_MCP_URL=http://localhost:8091/mcp
MATCHING_AGENT_URL=http://localhost:8081
AGENT_URL=http://localhost:8081

# Cloud Run sets these to id_token. Local compose leaves them as none.
MCP_AUTH_MODE=none
A2A_AUTH_MODE=none

LEDGERGUARD_DATA_DIR=
