# Optional container-only env file. Compose loads it when present (required: false).
# Paths here are inside the container. Do not point this file at a service account key.
GOOGLE_APPLICATION_CREDENTIALS=/tmp/keys/adc.json
GOOGLE_CLOUD_PROJECT=your-project-id
GOOGLE_CLOUD_LOCATION=global
GOOGLE_GENAI_USE_ENTERPRISE=TRUE
MODEL_ARMOR_PROMPT_TEMPLATE=
MODEL_ARMOR_RESPONSE_TEMPLATE=
MODEL_ARMOR_ALLOW_UNSCREENED=false
