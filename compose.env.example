# Container variables Compose always loads. Copy this file to compose.env for
# local values. compose.env is gitignored. The start scripts export it when
# the copy exists. Do not point either file at a service account key.
GOOGLE_APPLICATION_CREDENTIALS=/tmp/keys/adc.json
GOOGLE_CLOUD_PROJECT=your-project-id
GOOGLE_CLOUD_LOCATION=global
GOOGLE_GENAI_USE_ENTERPRISE=TRUE
MODEL_ARMOR_PROMPT_TEMPLATE=
MODEL_ARMOR_RESPONSE_TEMPLATE=
MODEL_ARMOR_ALLOW_UNSCREENED=false
